{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wireframe Screens Spec",
  "type": "object",
  "required": ["project", "canvas", "screens"],
  "properties": {
    "project": { "type": "string" },
    "index": {
      "type": "boolean",
      "default": true,
      "description": "true면 좌측에 전체 페이지 목록 패널을 자동 생성한다"
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "default": 375 },
        "height": { "type": "number", "default": 812 },
        "padding": { "type": "number", "default": 16 },
        "gap": { "type": "number", "default": 12 }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]{2}$" },
          "name": { "type": "string" },
          "group": { "type": "string", "description": "인증 / 메인 / 예약 등 영역명. 페이지 목록 패널의 소제목이 된다" },
          "note": { "type": "string" },
          "blocks": { "type": "array", "items": { "$ref": "#/definitions/block" } }
        }
      }
    }
  },
  "definitions": {
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "nav", "header", "hero", "text", "image",
            "searchbar", "chips", "input", "button",
            "card", "list", "grid", "table",
            "tabbar", "divider", "spacer", "row"
          ]
        },
        "label": { "type": "string" },
        "height": { "type": "number" },
        "items": { "type": "number" },
        "columns": { "type": "number" },
        "variant": { "enum": ["primary", "secondary", "ghost"] },
        "meta": {
          "type": "array",
          "items": { "type": "string" },
          "description": "card 전용. 카드에 붙는 짧은 정보 (예: 8인실, 3층)"
        },
        "action": { "type": "string", "description": "card 전용. 우측 버튼 라벨 (예: 바로 예약)" },
        "children": { "type": "array", "items": { "$ref": "#/definitions/block" } }
      }
    }
  }
}
